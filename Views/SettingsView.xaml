<UserControl x:Class="MyClock.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="Settings" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Focus rating, ignored apps, history, and display" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
            </ScrollViewer.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Verdict thresholds -->
                    <Border Padding="14,12" Style="{StaticResource MissionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="FOCUS RATING" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="A session's verdict comes from its foreground rate." />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource SettingLabelTextStyle}" Text="LOCKED IN from" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource MissionTextBoxStyle}"
                                         Text="{Binding LockedInPercent, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="%" />

                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="IN THE ZONE from" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,6,0,0"
                                         Style="{StaticResource MissionTextBoxStyle}"
                                         Text="{Binding InTheZonePercent, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="%" />

                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="HALF HERE from" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,6,0,0"
                                         Style="{StaticResource MissionTextBoxStyle}"
                                         Text="{Binding HalfHerePercent, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="6,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="%" />

                                <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="Rate sessions after" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,6,0,0"
                                         Style="{StaticResource MissionTextBoxStyle}"
                                         Text="{Binding MinimumRatedSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Margin="6,6,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="sec" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="Below HALF HERE is ESCAPE ARTIST. Shorter sessions are WARMING UP." />
                        </StackPanel>
                    </Border>

                    <!-- Comment language and clock format -->
                    <Border Margin="0,10,0,0" Padding="14,12" Style="{StaticResource MissionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="DISPLAY" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Comments and tips" />
                                <ComboBox Grid.Column="1"
                                          Width="110"
                                          Height="28"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding Languages}"
                                          SelectedValue="{Binding CommentLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          Style="{StaticResource MissionComboBoxStyle}" />
                            </Grid>
                            <CheckBox Margin="0,12,0,0"
                                      Content="24-hour clock"
                                      IsChecked="{Binding Use24HourClock}"
                                      Style="{StaticResource MissionCheckBoxStyle}" />
                            <CheckBox Content="Show seconds"
                                      IsChecked="{Binding ShowSeconds}"
                                      Style="{StaticResource MissionCheckBoxStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Applications that do not count as switches -->
                    <Border Padding="14,12" Style="{StaticResource MissionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="IGNORED APPS" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="Switching to these apps is not counted as a switch. Time spent there still counts as time away." />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Height="28"
                                          IsEditable="True"
                                          ItemsSource="{Binding RunningApps}"
                                          Style="{StaticResource MissionComboBoxStyle}"
                                          Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Pick a running app or type a process name, such as Spotify" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="12,5"
                                        Command="{Binding AddExcludedAppCommand}"
                                        Content="Add"
                                        Style="{StaticResource SecondaryActionButtonStyle}" />
                            </Grid>
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ExcludedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SettingLabelTextStyle}"
                                                       Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Padding="8,4"
                                                    Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Remove"
                                                    Style="{StaticResource TextActionButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="No ignored apps yet."
                                       Visibility="{Binding HasNoExcludedApps, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- History retention and data actions -->
                    <Border Margin="0,10,0,0" Padding="14,12" Style="{StaticResource MissionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="HISTORY" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Keep history for" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource MissionTextBoxStyle}"
                                         Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource SettingLabelTextStyle}" Text="days" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="Includes today. Older sessions are deleted at startup and each midnight." />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Padding="12,6"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Content="Open data folder"
                                        Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Padding="12,6"
                                        Command="{Binding ClearHistoryCommand}"
                                        Content="Clear history…"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Style="{StaticResource SecondaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Messages and save actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource ErrorBrush}"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasNoValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Command="{Binding RestoreDefaultsCommand}"
                        Content="Restore defaults"
                        Style="{StaticResource TextActionButtonStyle}" />
                <Button Margin="0"
                        Command="{Binding SaveCommand}"
                        Content="Save"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
